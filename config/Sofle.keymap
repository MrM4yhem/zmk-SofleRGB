#define U_MOUSE_SCROLL_MAX 20
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80 //Scroll max velocity default 10

#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    behaviors {
        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            display-name = "Main";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESC         &kp N1  &kp N2    &kp N3  &kp N4    &kp N5                               &kp N6  &kp N7         &kp N8     &kp N9     &kp N0    &kp DELETE
&kp TAB         &kp Q   &kp W     &kp E   &kp R     &kp T                                &kp Y   &kp U          &kp I      &kp O      &kp P     &kp SQT
&kp LEFT_SHIFT  &kp A   &kp S     &kp D   &kp F     &kp G                                &kp H   &kp J          &kp K      &kp L      &kp SEMI  &kp RET
&kp LCTRL       &kp Z   &kp X     &kp C   &kp V     &kp B   &kp C_MUTE        &none      &kp N   &kp M          &kp COMMA  &kp DOT    &kp FSLH  &kp BACKSPACE
                        &kp LGUI  &none   &kp LALT  &mo 1   &kp LEFT_SHIFT    &kp SPACE  &mo 2   &kp RIGHT_ALT  &none      &kp GRAVE
            >;

sensor-bindings = <&scroll_up_down &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        lower_layer {
            display-name = "lower";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp RA(LS(GRAVE))  &trans     &trans     &trans    &trans    &trans                                           &trans     &none     &none      &kp MINUS  &kp EQUAL              &trans
&trans             &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                                           &kp N6     &kp N7    &kp N8     &kp LBKT   &kp RBKT               &kp BACKSLASH
&trans             &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                                        &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RIGHT_PARENTHESIS  &none
&trans             &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &rgb_ug RGB_TOG    &rgb_ug RGB_EFF    &trans     &trans    &kp SEMI   &kp COLON  &kp BSLH               &kp LC(BACKSPACE)
                              &trans     &none     &trans    &trans     &kp LA(SPACE)      &kp LC(BACKSPACE)  &trans     &trans    &trans     &trans
            >;

sensor-bindings = <&scroll_up_down &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp RA(GRAVE)  &kp F1      &kp F2     &kp F3       &kp F4       &kp F5                             &kp F6  &kp F7    &kp F8       &kp F9         &kp F10    &kp F11
&trans         &kp INS     &kp UP     &kp K_CMENU  &trans       &trans                             &trans  &trans    &kp UP       &trans         &kp PSCRN  &kp F12
&trans         &kp LEFT    &kp DOWN   &kp RIGHT    &trans       &kp CLCK                           &trans  &kp LEFT  &kp DOWN     &kp RIGHT      &trans     &trans
&trans         &kp K_UNDO  &kp K_CUT  &kp K_COPY   &kp K_PASTE  &trans    &trans           &trans  &trans  &trans    &kp PAGE_UP  &kp PAGE_DOWN  &trans     &kp BACKSPACE
                           &trans     &trans       &trans       &trans    &kp BACKSPACE    &trans  &trans  &trans    &trans       &trans
            >;
sensor-bindings = <&scroll_up_down &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                    &bootloader   &none  &sys_reset       &none  &none  &to 4
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                                 &none         &none  &none            &none  &none  &none
&none              &none            &none            &none            &none            &out OUT_USB                                    &out OUT_BLE  &none  &none            &none  &none  &none
&none              &none            &none            &bl BL_INC       &none            &none            &rgb_ug RGB_TOG    &bl BL_TOG  &none         &none  &bl BL_DEC       &none  &none  &none
                                    &none            &rgb_ug RGB_BRI  &none            &trans           &none              &none       &trans        &none  &rgb_ug RGB_BRD  &none
            >;
        };

        Game {
            display-name = "Game";
            bindings = <
&none           &kp N1  &kp N2    &kp N3   &kp N4    &kp N5                           &kp N6  &kp N7         &kp N8     &kp N9     &kp N0    &to 0
&kp TAB         &kp Q   &kp W     &kp E    &kp R     &kp T                            &kp Y   &kp U          &kp I      &kp O      &kp P     &kp SQT
&kp LEFT_SHIFT  &kp A   &kp S     &kp D    &kp F     &kp G                            &kp H   &kp J          &kp K      &kp L      &kp SEMI  &kp RET
&kp LCTRL       &kp Z   &kp X     &kp C    &kp V     &kp B   &kp C_MUTE    &none      &kp N   &kp M          &kp COMMA  &kp DOT    &kp FSLH  &kp BACKSPACE
                        &kp LGUI  &kp ESC  &kp LALT  &mo 1   &kp SPACE     &kp SPACE  &mo 2   &kp RIGHT_ALT  &none      &kp GRAVE
            >;

sensor-bindings = <&scroll_up_down &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
